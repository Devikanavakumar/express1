<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Nexus | Error</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container error-center">
        <div class="card">
            <h1 class="error-code">!</h1>
            <h2>Something went wrong</h2>
            <p><%= typeof message !== 'undefined' ? message : "The page you are looking for does not exist." %></p>
            <br>
            <a href="/" class="btn-secondary">Return to Home</a>
        </div>
    </div>
</body>
</html>