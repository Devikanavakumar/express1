<div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 15px; overflow: hidden;">
      
      <div class="modal-header bg-dark text-white py-3">
        <h5 class="modal-title fw-bold" id="logoutModalLabel">
          <i class="bi bi-box-arrow-right me-2 text-primary"></i>Sign Out
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4 text-center">
        <div class="mb-3 text-primary">
            <i class="bi bi-door-open" style="font-size: 3rem;"></i>
        </div>
        <h5 class="fw-bold">Ready to leave?</h5>
        <p class="text-muted small">Select "Logout" below if you are ready to end your current session.</p>
        
        <form action="/logout" method="POST">
          <div class="d-flex gap-2 mt-4">
            <button type="button" class="btn btn-light flex-fill fw-bold border" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary flex-fill fw-bold shadow-sm">
              Logout
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>
</div>