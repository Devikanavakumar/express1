<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NEXUS| <%= typeof title != 'undefined' ? title : 'Secure Notes' %></title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Montserrat:wght@700&display=swap" rel="stylesheet">
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  
  <style>
    :root {
      --primary-color: #0d6efd;
      --dark-bg: #212529;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: #f8f9fa;
      color: #333;
      display: flex;
      flex-direction: column;
      min-height: 100vh; /* Ensures footer stays at bottom */
    }

    .navbar-brand {
      font-family: 'Montserrat', sans-serif;
      letter-spacing: -1px;
    }

    main {
      flex: 1 0 auto; /* Pushes footer down if content is short */
    }

    /* Modern Scrollbar */
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #f1f1f1; }
    ::-webkit-scrollbar-thumb { background: #ccc; border-radius: 10px; }
    ::-webkit-scrollbar-thumb:hover { background: #bbb; }
  </style>
</head>
<body>

  <%- include('../partials/navbar') %>

  <main class="animate-fade-in">
    <%- body %>
  </main>

  <footer class="bg-dark text-white py-5 mt-5">
    <div class="container text-center">
      <div class="mb-3">
        <a class="navbar-brand fw-bold text-primary fs-4 text-decoration-none" href="/">NEXUS</a>
      </div>
      <p class="text-secondary small mb-2">Designed for maximum productivity and data privacy.</p>
      <div class="d-flex justify-content-center gap-3 mb-4">
        <a href="#" class="text-secondary"><i class="bi bi-github"></i></a>
        <a href="#" class="text-secondary"><i class="bi bi-twitter-x"></i></a>
        <a href="#" class="text-secondary"><i class="bi bi-linkedin"></i></a>
      </div>
      <hr class="w-25 mx-auto opacity-25">
      <p class="small text-secondary mt-3">
        &copy; 2026 NEXUS. All rights reserved. 
        <span class="mx-2">|</span> 
        <a href="/about" class="text-secondary text-decoration-none">About</a>
      </p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>