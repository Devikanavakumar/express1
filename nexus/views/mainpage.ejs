<div class="container py-5">
  <div class="row mb-4">
    <div class="col-12">
      <h2 class="fw-bold border-bottom pb-2">
        <i class="bi bi-journal-text text-primary me-2"></i>My Notes
      </h2>
    </div>
  </div>

  <div class="row justify-content-center mb-5">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow border-0">
        <div class="card-header bg-dark text-white py-3">
          <h5 class="card-title mb-0"><i class="bi bi-plus-circle me-2"></i>Create New Note</h5>
        </div>
        <div class="card-body p-4">
          <form action="/note" method="POST">
            <div class="mb-3">
              <label class="form-label fw-bold small">Title</label>
              <input type="text" name="title" class="form-control form-control-lg" placeholder="Enter note title..." required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold small">Description</label>
              <textarea name="description" class="form-control" rows="4" placeholder="Write your thoughts here..." required></textarea>
            </div>
            <div class="d-grid">
              <button type="submit" class="btn btn-primary btn-lg shadow-sm fw-bold">
                <i class="bi bi-save me-2"></i>Save Note
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <hr class="my-5 opacity-25">

  <div class="row">
    <% if (notes && notes.length > 0) { %>
      <% notes.forEach(note => { %>
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card h-100 shadow-sm border-0 hover-shadow transition">
            <div class="card-body p-4">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <h5 class="card-title fw-bold text-dark mb-0"><%= note.title %></h5>
                <span class="badge bg-light text-primary border"><i class="bi bi-pin-angle"></i></span>
              </div>
              <p class="card-text text-muted"><%= note.description %></p>
            </div>
            <div class="card-footer bg-transparent border-0 px-4 pb-4 d-flex gap-2">
              <button class="btn btn-outline-info btn-sm flex-fill">
                <i class="bi bi-pencil-square me-1"></i>Edit
              </button>
              <button class="btn btn-outline-danger btn-sm flex-fill">
                <i class="bi bi-trash me-1"></i>Delete
              </button>
            </div>
          </div>
        </div>
      <% }) %>

      <% if (totalPages > 1) { %>
        <div class="col-12 d-flex justify-content-center mt-4">
          <nav aria-label="Page navigation">
            <ul class="pagination shadow-sm">
              <% for(let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= current == i ? 'active' : '' %>">
                  <a class="page-link px-3" href="/mainpage?page=<%= i %>"><%= i %></a>
                </li>
              <% } %>
            </ul>
          </nav>
        </div>
      <% } %>

    <% } else { %>
      <div class="col-12 text-center py-5">
        <div class="text-muted">
          <i class="bi bi-folder-x display-1"></i>
          <p class="mt-3 lead">No notes found. Start by creating your first note above!</p>
        </div>
      </div>
    <% } %>
  </div>
</div>

<style>
  .transition { transition: all 0.3s ease; }
  .hover-shadow:hover { 
    transform: translateY(-5px);
    box-shadow: 0 1rem 3rem rgba(0,0,0,.175)!important; 
  }
</style>