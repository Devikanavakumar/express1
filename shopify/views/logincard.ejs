<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registered Users</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <style>
    body {
      background: #f0f4f8;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    h2 {
      color: #333;
      font-weight: 600;
    }

    .card {
      border-radius: 15px;
      transition: transform 0.2s, box-shadow 0.2s;
      background: linear-gradient(145deg, #ffffff, #e6f0ff);
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    }

    .card-title {
      font-size: 1.3rem;
      font-weight: 600;
      color: #007bff;
    }

    .card-text {
      font-size: 0.95rem;
      color: #555;
      margin: 4px 0;
    }

    .container {
      padding-top: 30px;
      padding-bottom: 50px;
    }

    @media (max-width: 768px) {
      .col-md-4 {
        margin-bottom: 20px;
      }
    }
  </style>
</head>
<body>
<div class="container">
  <h2 class="text-center mb-5">Registered Users</h2>
  <div class="row">
    <% users.forEach(user => { %>
      <div class="col-md-4 col-sm-6 mb-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h5 class="card-title"><%= user.username %></h5>
            <p class="card-text"><strong>Email:</strong> <%= user.email %></p>
            <p class="card-text"><strong>Password:</strong> <%= user.password %></p>
            <p class="card-text"><strong>Date:</strong> <%= user.createdAt.toLocaleDateString() %></p>
            <p class="card-text"><strong>Time:</strong> <%= user.createdAt.toLocaleTimeString() %></p>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<!-- Bootstrap JS -->

</body>
</html>