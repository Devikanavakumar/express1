<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Products</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">

      <% if (errors && errors.length > 0) { %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% errors.forEach(err => { %>
              <li><%= err %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <% if (success) { %>
        <div class="alert alert-success">
          <%= success %>
        </div>
      <% } %>

      <div class="card shadow-sm">
        <div class="card-header text-center">Add Product</div>
        <div class="card-body">
          <form action="/products" method="POST">
            <input type="text" class="form-control mb-3" name="name" placeholder="Product Name" value="<%= name %>">
            <input type="number" class="form-control mb-3" name="quantity" placeholder="Quantity" value="<%= quantity %>">
            <input type="number" class="form-control" name="price" placeholder="Price" value="<%= price %>">
            <div class="text-center mt-3">
              <input type="submit" class="btn btn-primary" value="SUBMIT">
            </div>
          </form>
        </div>
      </div>

    </div>
  </div>
</div>
</body>
</html>