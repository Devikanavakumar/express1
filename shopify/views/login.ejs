<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>
  <div class="container mt-5">

    <!-- ERROR ALERT ABOVE THE CARD -->
    <% if (errors && errors.length> 0) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <ul class="mb-0">
          <% errors.forEach(err=> { %>
            <li>
              <%= err %>
            </li>
            <% }) %>
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
      <% } %>

        <% if (success) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= success %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
          <% } %>


            <div class="row justify-content-center">
              <div class="col-md-5">
                <div class="card">
                  <div class="card-header ">
                    <h1 class="justify-content-center">Register</h1>
                  </div>
                  <div class="card-body">
                    <form action="/login" method="post">
                      <input type="text" name="username" class="form-control mb-3" value="<%= username || '' %>"
                        placeholder="UserName">
                      <input type="email" name="email" class="form-control mb-3" value="<%= email || '' %>"
                        placeholder="Email">
                      <input type="password" name="password" class="form-control mb-3" placeholder="Password">
                      <div class="text-center mt-3">
                        <input type="submit" class="btn btn-primary" value="SUBMIT">
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </div>

  </div>
</body>

</html>